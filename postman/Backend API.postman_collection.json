{
  "info": {
    "name": "Backend API",
    "description": "Requests for the backend API, including assessment-only OTP requests, registration, login and profiles. At most three successful OTP requests are allowed per phone number in a rolling hour. Use a new phone number when running the complete collection again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "phone_number",
      "value": "8562056666666"
    },
    {
      "key": "temporary_token",
      "value": ""
    },
    {
      "key": "otp_code",
      "value": ""
    },
    {
      "key": "name",
      "value": "John Doe"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "updated_name",
      "value": "Jane Doe"
    }
  ],
  "item": [
    {
      "name": "Request OTP - JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OTP request succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('Response contains a six-digit OTP and temporary token', function () {",
              "    pm.expect(body.data.otp_code).to.match(/^\\d{6}$/);",
              "    pm.expect(pm.response.headers.get('X-Temporary-Token')).to.be.a('string').and.not.empty;",
              "  });",
              "  pm.collectionVariables.set('temporary_token', pm.response.headers.get('X-Temporary-Token'));",
              "  pm.collectionVariables.set('otp_code', body.data.otp_code);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"{{phone_number}}\"\n}"
        },
        "url": "{{base_url}}/api/auth/otp"
      }
    },
    {
      "name": "Request OTP - form-data",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Form-data OTP request succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('temporary_token', pm.response.headers.get('X-Temporary-Token')); }",
              "if (pm.response.code === 200) { pm.collectionVariables.set('otp_code', pm.response.json().data.otp_code); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "phone_number",
              "value": "{{phone_number}}",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/api/auth/otp"
      }
    },
    {
      "name": "Reject unknown field",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown field is rejected', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().code).to.eql('VALIDATION_ERR_UNKNOWN_FIELD');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"{{phone_number}}\",\n  \"unexpected\": \"value\"\n}"
        },
        "url": "{{base_url}}/api/auth/otp"
      }
    },
    {
      "name": "Validation error - Lao",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Validation error is in Lao', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().message).to.eql('ຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept-Language",
            "value": "lo"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"123\"\n}"
        },
        "url": "{{base_url}}/api/auth/otp"
      }
    },
    {
      "name": "Validation error - English fallback",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unsupported language defaults to English', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().message).to.eql('Bad Request');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept-Language",
            "value": "fr"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"123\"\n}"
        },
        "url": "{{base_url}}/api/auth/otp"
      }
    },
    {
      "name": "Register with OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Register with OTP succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const token = pm.response.json().data.access_token;",
              "  pm.test('Access token is returned', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
              "  pm.collectionVariables.set('access_token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{temporary_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"otp_code\": \"{{otp_code}}\",\n  \"name\": \"{{name}}\"\n}"
        },
        "url": "{{base_url}}/api/auth/register"
      }
    },
    {
      "name": "Request OTP for login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login OTP request succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('temporary_token', pm.response.headers.get('X-Temporary-Token'));",
              "  pm.collectionVariables.set('otp_code', pm.response.json().data.otp_code);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"{{phone_number}}\"\n}"
        },
        "url": "{{base_url}}/api/auth/otp"
      }
    },
    {
      "name": "Login with OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login with OTP succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const token = pm.response.json().data.access_token;",
              "  pm.test('Access token is returned', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
              "  pm.collectionVariables.set('access_token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{temporary_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"otp_code\": \"{{otp_code}}\"\n}"
        },
        "url": "{{base_url}}/api/auth/login"
      }
    },
    {
      "name": "Get my profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get my profile', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.phone_number).to.eql(pm.collectionVariables.get('phone_number')); ",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/api/users/me"
      }
    },
    {
      "name": "Update my name",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update my name', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.phone_number).to.eql(pm.collectionVariables.get('phone_number')); ",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{updated_name}}\"\n}"
        }
      }
    },
    {
      "name": "Reject phone number update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reject phone number update', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().code).to.eql('VALIDATION_ERR_UNKNOWN_FIELD');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"8562051111111\",\n  \"name\": \"{{updated_name}}\"\n}"
        }
      }
    }
  ]
}
